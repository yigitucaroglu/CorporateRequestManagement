@api = https://localhost:7001
@accessToken = <employee-access-token>
@adminAccessToken = <admin-access-token>
@requestId = <request-guid>
@rowVersion = <latest-base64-rowversion>

### Development-only Employee login — parola için README seed tablosunu kullanın
POST {{api}}/api/auth/login
Content-Type: application/json

{"email":"employee@company.com","password":"<development-demo-password>"}

### Create Equipment draft — enum numeric 2, amount zorunlu
POST {{api}}/api/requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"Yeni ekipman talebi","description":"Geliştirme ortamı örnek talebi","requestType":2,"amount":1250.00}

### Create Other draft — enum numeric 4, amount nullable
POST {{api}}/api/requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"Diğer talep","description":"Tutar gerektirmeyen örnek talep","requestType":4,"amount":null}

### Create Expense draft — enum numeric 1, amount zorunlu
POST {{api}}/api/requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"Masraf talebi","description":"Geliştirme masraf örneği","requestType":1,"amount":450.00}

### My requests
GET {{api}}/api/requests?pageNumber=1&pageSize=20&searchTerm=ekipman&status=Draft&requestType=Equipment&sortBy=createdDate&sortDirection=Descending
Authorization: Bearer {{accessToken}}

### Detail
GET {{api}}/api/requests/{{requestId}}
Authorization: Bearer {{accessToken}}

### Update draft
PUT {{api}}/api/requests/{{requestId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"Güncellenmiş talep","description":"Güncel açıklama","requestType":2,"amount":1300.00,"rowVersion":"{{rowVersion}}"}

### Submit
POST {{api}}/api/requests/{{requestId}}/submit
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rowVersion":"{{rowVersion}}"}

### Cancel
POST {{api}}/api/requests/{{requestId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rowVersion":"{{rowVersion}}"}

### Soft-delete — Admin endpoint; admin token kullanın
DELETE {{api}}/api/admin/requests/{{requestId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{"rowVersion":"{{rowVersion}}"}
