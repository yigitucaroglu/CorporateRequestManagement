{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
  ,"Jwt": { "Issuer": "CorporateRequestManagement.Api", "Audience": "CorporateRequestManagement.Clients", "AccessTokenMinutes": 15, "RefreshTokenDays": 7 }
