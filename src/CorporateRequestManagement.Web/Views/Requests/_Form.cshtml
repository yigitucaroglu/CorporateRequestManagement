@model RequestInputModel
<div asp-validation-summary="ModelOnly" class="crm-validation-summary"></div><div class="crm-form-grid"><div class="crm-field crm-span-2"><label asp-for="Title">Başlık</label><input asp-for="Title" maxlength="200" data-count-input/><small><span data-count-output>0</span>/200</small><span asp-validation-for="Title"></span></div><div class="crm-field"><label asp-for="RequestType">Talep Türü</label><select asp-for="RequestType" data-request-type><option value="">Seçiniz</option><option value="1" data-requires-amount="true">Masraf</option><option value="2" data-requires-amount="true">Ekipman</option><option value="3" data-requires-amount="false">İzin</option><option value="4" data-requires-amount="false">Diğer</option></select><span asp-validation-for="RequestType"></span></div><div class="crm-field" data-amount-field><label asp-for="Amount">Tutar (₺)</label><input asp-for="Amount" inputmode="decimal" step="0.01" min="0.01"/><span asp-validation-for="Amount"></span></div><div class="crm-field crm-span-2"><label asp-for="Description">Açıklama</label><textarea asp-for="Description" rows="7" maxlength="2000" data-count-input></textarea><small><span data-count-output>0</span>/2000</small><span asp-validation-for="Description"></span></div></div>
