@model RequestDetailsPage
@{ViewData["Title"]="Talep Detayı";var s=UiDisplay.Status(Model.Request.Status);}
<div class="crm-page-head"><div><a class="crm-back" asp-action="Index">← Taleplerime dön</a><h2>@Model.Request.Title</h2><p>@UiDisplay.Type(Model.Request.RequestType) · @Model.Request.DepartmentName</p></div><span class="crm-badge crm-badge-lg crm-badge-@s.Tone">@s.Label</span></div>
<div class="crm-detail-grid"><section class="crm-card"><div class="crm-detail-meta"><div><span>Tutar</span><strong>@(Model.Request.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "Belirtilmedi")</strong></div><div><span>Oluşturulma</span><strong>@Model.Request.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong></div><div><span>Son Güncelleme</span><strong>@Model.Request.UpdatedDate.ToString("dd.MM.yyyy HH:mm")</strong></div></div><div class="crm-description"><h3>Açıklama</h3><p>@Model.Request.Description</p></div><div class="crm-detail-actions">@if(Model.Request.Status==RequestStatusContract.Draft){<a class="crm-btn crm-btn-secondary" asp-action="Edit" asp-route-id="@Model.Request.Id">Düzenle</a><form asp-action="Submit" asp-route-id="@Model.Request.Id" method="post" data-submit-form><input type="hidden" name="rowVersion" value="@Model.Request.RowVersion"/><button class="crm-btn crm-btn-primary" data-submit-button>Onaya Gönder</button></form>}@if(Model.Request.Status is RequestStatusContract.Draft or RequestStatusContract.PendingManagerApproval){<form asp-action="Cancel" asp-route-id="@Model.Request.Id" method="post" data-confirm="Talebi iptal etmek istediğinize emin misiniz?"><input type="hidden" name="rowVersion" value="@Model.Request.RowVersion"/><button class="crm-btn crm-btn-danger-quiet">Talebi İptal Et</button></form>}</div></section><section class="crm-card"><div class="crm-section-head"><div><h3>Onay Geçmişi</h3><p>Talep üzerinde verilen kararlar</p></div></div><partial name="_ApprovalTimeline" model="Model.History"/></section></div>
