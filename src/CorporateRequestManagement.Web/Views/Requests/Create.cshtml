@model RequestInputModel
@{ ViewData["Title"] = "Yeni Talep"; }
<div class="crm-form-page">
    <div class="crm-form-page__container">
        <div class="crm-page-head crm-form-page__heading"><div><h2>Yeni Talep</h2><p>İhtiyacınızı açık ve ölçülü bilgilerle kaydedin.</p></div></div>
        <form method="post" class="crm-card crm-form-card crm-form-card--premium" data-submit-form>
            <partial name="_Form" model="Model" />
            <div class="crm-form-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index">Vazgeç</a><button class="crm-btn crm-btn-primary" data-submit-button>Talebi Oluştur</button></div>
        </form>
    </div>
</div>
