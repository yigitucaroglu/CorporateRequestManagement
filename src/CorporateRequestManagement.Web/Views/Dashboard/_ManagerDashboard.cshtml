@model ManagerDashboardContract
<div class="crm-kpi-grid" data-dashboard="manager"><partial name="_Kpi" model='("Bekleyen Yönetici Onayı",Model.PendingApprovals,"Departmanınızda karar bekliyor","warning")'/><partial name="_Kpi" model='("Bu Ay Gelen",Model.MonthlyIncoming,"Departmana gönderilen talepler","primary")'/><partial name="_Kpi" model='("Bu Ay Onaylanan",Model.MonthlyApproved,"Verdiğiniz olumlu kararlar","success")'/><partial name="_Kpi" model='("Bu Ay Reddedilen",Model.MonthlyRejected,"Verdiğiniz ret kararları","danger")'/></div>
<div class="crm-analytics-grid"><partial name="_DashboardTrend" model='DashboardTrendViewModel.Create(Model.Trend,"Son 30 Gün Talep Grafiği","Talep","Karar",DashboardTrendGranularity.Daily)'/><partial name="_DashboardDistribution" model='(Model.DecisionDistribution,"Yönetici Karar Dağılımı")'/></div>
<div class="crm-dashboard-equal-grid" data-equal-cards><section class="crm-card crm-dashboard-list-card"><div class="crm-section-head"><div><h3>Son Taleplerim</h3><p>Kendi son beş talebiniz</p></div><a asp-controller="Requests" asp-action="Index">Tümünü gör</a></div><partial name="_DashboardRecent" model="Model.RecentRequests" /></section><section class="crm-card crm-dashboard-list-card"><div class="crm-section-head"><div><h3>Bekleyen Onaylar</h3><p>Departmanınızda kararınızı bekleyenler</p></div><a asp-controller="ManagerApprovals" asp-action="Index">Kuyruğa git</a></div><partial name="_DashboardPending" model='(Model.PendingPreview,false)' /></section></div>
