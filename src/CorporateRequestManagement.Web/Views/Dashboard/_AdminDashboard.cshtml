@model AdminDashboardContract
<div class="crm-kpi-grid" data-dashboard="admin"><partial name="_Kpi" model='("Yönetim Onayı Bekleyen",Model.PendingApprovals,"Yönetim kararı bekleyen talepler","warning")'/><partial name="_Kpi" model='("Bu Ay Oluşturulan",Model.MonthlyCreated,"Sisteme eklenen talepler","primary")'/><partial name="_Kpi" model='("Bu Ay Onaylanan",Model.MonthlyApproved,"Olumlu tamamlanan talepler","success")'/><partial name="_Kpi" model='("Bu Ay Reddedilen",Model.MonthlyRejected,"Reddedilerek tamamlanan talepler","danger")'/></div>
<div class="crm-analytics-grid"><partial name="_DashboardTrend" model='DashboardTrendViewModel.Create(Model.Trend,"Son 12 Ay Sistem Talep Grafiği","Oluşturulan","Tamamlanan",DashboardTrendGranularity.Monthly)'/><partial name="_DashboardDistribution" model='(Model.StatusDistribution,"Sistem Durum Dağılımı")'/></div>
<div class="crm-analytics-grid crm-analytics-grid-secondary"><partial name="_DashboardDistribution" model='(Model.DepartmentDistribution,"Departman Dağılımı")'/><section class="crm-card crm-dashboard-list-card"><div class="crm-section-head"><div><h3>Yönetim Onayı Bekleyenler</h3><p>Karar bekleyen ilk beş talep</p></div><a asp-controller="AdminApprovals" asp-action="Index">Kuyruğa git</a></div><partial name="_DashboardPending" model='(Model.PendingPreview,true)' /></section></div>
