@model (IReadOnlyList<DashboardPendingApprovalContract> Items, bool Admin)
@if(Model.Items.Count==0){<partial name="_EmptyState" model='("Bekleyen onay bulunmuyor.","Yeni bir görev geldiğinde burada görünecek.")'/>}else{<div class="crm-compact-list">@foreach(var item in Model.Items){<a asp-controller="@(Model.Admin ? "AdminApprovals" : "ManagerApprovals")" asp-action="Details" asp-route-id="@item.RequestId"><span><strong>@item.Title</strong><small>@item.RequesterName · @item.DepartmentName</small></span><span class="crm-amount">@(item.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))??"—")</span></a>}</div>}
