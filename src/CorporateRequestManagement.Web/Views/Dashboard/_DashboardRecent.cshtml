@model IReadOnlyList<DashboardRecentRequestContract>
@if(Model.Count==0){<partial name="_EmptyState" model='("Henüz talep bulunmuyor.","Yeni bir talep oluşturduğunuzda burada görünecek.")'/>}else{<div class="crm-compact-list">@foreach(var item in Model){var status=UiDisplay.Status(item.Status);<a asp-controller="Requests" asp-action="Details" asp-route-id="@item.Id"><span><strong>@item.Title</strong><small>@UiDisplay.Type(item.RequestType) · @item.Date.ToString("dd.MM.yyyy")</small></span><span class="crm-badge crm-badge-@status.Tone">@status.Label</span></a>}</div>}
