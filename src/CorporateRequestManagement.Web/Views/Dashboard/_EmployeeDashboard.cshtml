@model EmployeeDashboardContract
<div class="crm-kpi-grid" data-dashboard="employee"><partial name="_Kpi" model='("Toplam Talep",Model.TotalRequests,"Dosyanızdaki tüm talepler","primary")'/><partial name="_Kpi" model='("Onay Bekleyen",Model.PendingRequests,"Yönetici veya yönetim kararı bekliyor","warning")'/><partial name="_Kpi" model='("Onaylanan",Model.ApprovedRequests,"Olumlu sonuçlanan talepler","success")'/><partial name="_Kpi" model='("Reddedilen",Model.RejectedRequests,"Olumsuz sonuçlanan talepler","danger")'/></div>
<div class="crm-analytics-grid"><partial name="_DashboardTrend" model='DashboardTrendViewModel.Create(Model.Trend,"Son 30 Gün Talep Grafiği","Talep","",DashboardTrendGranularity.Daily)'/><partial name="_DashboardDistribution" model='(Model.StatusDistribution,"Durum Dağılımı")'/></div>
<section class="crm-card crm-dashboard-list-card crm-recent-card"><div class="crm-section-head"><div><h3>Son Taleplerim</h3><p>En son güncellenen beş talebiniz</p></div><a class="crm-btn crm-btn-secondary" asp-controller="Requests" asp-action="Index">Taleplerimi Görüntüle</a></div><partial name="_DashboardRecent" model="Model.RecentRequests" /></section>
