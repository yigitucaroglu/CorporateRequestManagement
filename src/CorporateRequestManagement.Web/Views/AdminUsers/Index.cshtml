@model AdminUsersPage
@{ ViewData["Title"]="Kullanıcılar"; bool filtered=!string.IsNullOrWhiteSpace(Model.Query.Role)||Model.Query.IsActive.HasValue||Model.Query.DepartmentId.HasValue; var pager=new PaginationViewModel(Model.Result.PageNumber,Model.Result.PageSize,Model.Result.TotalCount,Model.Result.TotalPages,Model.Result.HasPreviousPage,Model.Result.HasNextPage,new Dictionary<string,string?>{{"SearchTerm",Model.Query.SearchTerm},{"Role",Model.Query.Role},{"IsActive",Model.Query.IsActive?.ToString()},{"DepartmentId",Model.Query.DepartmentId?.ToString()},{"SortBy",Model.Query.SortBy},{"SortDirection",Model.Query.SortDirection},{"PageSize",Model.Query.PageSize.ToString(System.Globalization.CultureInfo.InvariantCulture)}}); }
<div class="crm-page-head"><div><span class="crm-kicker">Yönetim</span><h2>Kullanıcılar</h2><p>Sistem kullanıcılarını, rollerini ve departman ilişkilerini yönetin.</p></div></div>
<div class="crm-request-toolbar"><form method="get" class="crm-search-form crm-request-toolbar__search"><label class="crm-visually-hidden" for="user-search">Kullanıcı ara</label><input id="user-search" name="SearchTerm" value="@Model.Query.SearchTerm" placeholder="Ad, soyad veya e-posta ile ara"/><input type="hidden" name="DepartmentId" value="@Model.Query.DepartmentId"/><button class="crm-btn crm-btn-secondary">Ara</button></form><div class="crm-actions crm-request-toolbar__actions"><button class="crm-btn crm-btn-secondary" type="button" data-crm-filter-toggle aria-expanded="@(filtered.ToString().ToLowerInvariant())" aria-controls="user-filters">Filtreler</button><a class="crm-btn crm-btn-primary" asp-action="Create" asp-route-departmentId="@Model.Query.DepartmentId" asp-route-returnToDepartment="@Model.Query.DepartmentId">Yeni Kullanıcı Oluştur</a></div></div>
<div id="user-filters" class="crm-filter-panel" data-crm-filter-panel hidden="@(!filtered)"><form method="get" class="crm-filter"><input type="hidden" name="SearchTerm" value="@Model.Query.SearchTerm"/><div><label for="user-role">Rol</label><select id="user-role" name="Role"><option value="">Tümü</option><option value="Employee" selected="@(Model.Query.Role=="Employee")">Çalışan</option><option value="Manager" selected="@(Model.Query.Role=="Manager")">Yönetici</option><option value="Admin" selected="@(Model.Query.Role=="Admin")">Sistem Yöneticisi</option></select></div><div><label for="user-state">Durum</label><select id="user-state" name="IsActive"><option value="">Tümü</option><option value="true" selected="@(Model.Query.IsActive==true)">Aktif</option><option value="false" selected="@(Model.Query.IsActive==false)">Pasif</option></select></div><div><label for="user-department">Departman</label><select id="user-department" name="DepartmentId"><option value="">Tümü</option>@foreach(var d in Model.Departments){<option value="@d.Id" selected="@(Model.Query.DepartmentId==d.Id)">@d.Name</option>}</select></div><footer class="crm-filter-footer"><div class="crm-filter-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index">Filtreleri Temizle</a><button class="crm-btn crm-btn-primary">Uygula</button></div></footer></form></div>
<section class="crm-card crm-table-card">
@if(Model.Result.Items.Count==0)
{
    @if(Model.Query.DepartmentId.HasValue){<div class="crm-empty"><h3>Bu departmana bağlı kullanıcı bulunmuyor.</h3><p>Departman bağlamı korunarak yeni bir kullanıcı oluşturabilirsiniz.</p><a class="crm-btn crm-btn-primary" asp-action="Create" asp-route-departmentId="@Model.Query.DepartmentId" asp-route-returnToDepartment="@Model.Query.DepartmentId">Yeni Kullanıcı Oluştur</a></div>}
    else { <partial name="_EmptyState" model='("Kullanıcı bulunamadı.","Arama veya filtrelerinizi değiştirerek yeniden deneyin.")'/> }
}
else
{
    <div class="crm-table-wrap"><table class="crm-request-table"><thead><tr><th>Kullanıcı</th><th>E-posta</th><th>Rol</th><th>Departman</th><th>Durum</th><th>Oluşturulma</th><th class="crm-text-end">İşlemler</th></tr></thead><tbody>
    @foreach(var x in Model.Result.Items){<tr><td data-label="Kullanıcı"><span class="crm-user-cell"><span class="crm-avatar">@Phase7Display.Initials(x.FirstName,x.LastName)</span><strong>@x.FirstName @x.LastName</strong></span></td><td data-label="E-posta">@x.Email</td><td data-label="Rol">@UiDisplay.Role(x.Role.ToString())</td><td data-label="Departman">@(x.DepartmentName??"Atanmadı")</td><td data-label="Durum"><span class="crm-badge crm-badge-@(x.IsActive?"success":"neutral")">@Phase7Display.Active(x.IsActive)</span></td><td data-label="Oluşturulma">@x.CreatedDate.ToString("dd.MM.yyyy")</td><td data-label="İşlemler" class="crm-text-end"><details class="crm-action-menu"><summary>İşlemler <span aria-hidden="true">⋮</span></summary><div><a asp-action="Details" asp-route-id="@x.Id">Detayı Görüntüle</a><a asp-action="Edit" asp-route-id="@x.Id">Düzenle</a><a asp-action="Details" asp-route-id="@x.Id" asp-fragment="password-reset">Parolayı Sıfırla</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" data-confirm="Bu kullanıcı aktif listelerden kaldırılacaktır. Devam etmek istiyor musunuz?"><button class="crm-menu-danger">Sil</button></form></div></details></td></tr>}
    </tbody></table></div><partial name="_Pagination" model="pager"/>
}
</section>
