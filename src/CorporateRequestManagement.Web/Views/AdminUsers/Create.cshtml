@model AdminUserFormPage
@{ ViewData["Title"] = "Yeni Kullanıcı"; }
<div class="crm-page-head"><div><a class="crm-back" asp-action="Index" asp-route-departmentId="@Model.SelectedDepartmentId">← Kullanıcılara dön</a><h2>Yeni Kullanıcı</h2><p>Kullanıcının kimlik, organizasyon ve başlangıç güvenlik bilgilerini tanımlayın.</p></div></div>
@if (ViewData["SafeErrorMessage"] is string errorMessage) { <div class="crm-alert crm-alert-danger" role="alert">@errorMessage</div> }
<section class="crm-card crm-form-card"><form method="post" autocomplete="off">
    <input type="hidden" name="returnToDepartment" value="@Model.ReturnToDepartment"/><div asp-validation-summary="ModelOnly" class="crm-validation-summary"></div>
    <div class="crm-form-section"><h3>Kişisel Bilgiler</h3><div class="crm-form-grid"><div class="crm-field"><label for="firstName">Ad</label><input id="firstName" name="firstName" required/><span>@Html.ValidationMessage("FirstName")</span></div><div class="crm-field"><label for="lastName">Soyad</label><input id="lastName" name="lastName" required/><span>@Html.ValidationMessage("LastName")</span></div><div class="crm-field crm-span-2"><label for="email">E-posta</label><input id="email" name="email" type="email" required/><span>@Html.ValidationMessage("Email")</span></div></div></div>
    <div class="crm-form-section"><h3>Yetki ve Organizasyon</h3><div class="crm-form-grid"><div class="crm-field"><label for="role">Rol</label><select id="role" name="role"><option value="1">Çalışan</option><option value="2" selected="@(Model.SelectedDepartmentId.HasValue)">Yönetici</option><option value="3">Sistem Yöneticisi</option></select></div><div class="crm-field"><label for="departmentId">Departman</label><select id="departmentId" name="departmentId"><option value="">Departman gerekmiyor</option>@foreach(var d in Model.Departments){<option value="@d.Id" selected="@(Model.SelectedDepartmentId == d.Id)">@d.Name</option>}</select><span>@Html.ValidationMessage("DepartmentId")</span></div><label class="crm-check"><input name="isActive" type="checkbox" value="true" checked/><span>Hesap aktif</span></label></div></div>
    <div class="crm-form-section"><h3>Başlangıç Parolası</h3><p class="crm-help">Güçlü ve kullanıcıya güvenli kanaldan iletilecek bir parola belirleyin.</p><div class="crm-form-grid"><div class="crm-field"><label for="initialPassword">Parola</label><input id="initialPassword" name="initialPassword" type="password" required autocomplete="new-password"/><span>@Html.ValidationMessage("InitialPassword")@Html.ValidationMessage("Password")</span></div><div class="crm-field"><label for="confirmInitialPassword">Parola tekrar</label><input id="confirmInitialPassword" name="confirmInitialPassword" type="password" required autocomplete="new-password"/><span>@Html.ValidationMessage("confirmInitialPassword")</span></div></div></div>
    <div class="crm-form-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index" asp-route-departmentId="@Model.SelectedDepartmentId">İptal</a><button class="crm-btn crm-btn-primary">Kullanıcıyı Oluştur</button></div>
</form></section>
