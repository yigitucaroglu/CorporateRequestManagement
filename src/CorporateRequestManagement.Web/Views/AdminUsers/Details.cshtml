@model AdminUserContract
@{ViewData["Title"]="Kullanıcı Detayı";bool openPasswordReset=ViewData["OpenPasswordReset"] as bool? == true;var passwordErrors=ViewData["PasswordErrors"] as IReadOnlyList<string>??[];var confirmationErrors=ViewData["ConfirmationErrors"] as IReadOnlyList<string>??[];var summaryErrors=ViewData["PasswordSummaryErrors"] as IReadOnlyList<string>??[];}
<div class="crm-page-head"><div class="crm-detail-head__copy"><a class="crm-back" asp-action="Index">← Kullanıcılara dön</a><h2>@Model.FirstName @Model.LastName</h2><p>@Model.Email</p></div><div class="crm-actions"><a class="crm-btn crm-btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a><button class="crm-btn crm-btn-primary" type="button" data-modal-open="password-reset">Parolayı Sıfırla</button></div></div>
<div class="crm-detail-grid"><section class="crm-card"><div class="crm-identity"><span class="crm-avatar crm-avatar-lg">@ManagementDisplay.Initials(Model.FirstName,Model.LastName)</span><div><h3>@Model.FirstName @Model.LastName</h3><p>@Model.Email</p><div><span class="crm-badge crm-badge-neutral">@UiDisplay.Role(Model.Role.ToString())</span> <span class="crm-badge crm-badge-@(Model.IsActive?"success":"neutral")">@ManagementDisplay.Active(Model.IsActive)</span></div></div></div><div class="crm-section-head"><div><h3>Kurumsal Bilgiler</h3><p>Rol ve organizasyon özeti</p></div></div><div class="crm-detail-meta"><div><span>Departman</span><strong>@(Model.DepartmentName??"Atanmadı")</strong></div><div><span>Rol</span><strong>@UiDisplay.Role(Model.Role.ToString())</strong></div><div><span>Hesap oluşturulma</span><strong>@Model.CreatedDate.ToString("dd.MM.yyyy")</strong></div></div></section><section class="crm-card crm-danger-zone"><h3>Kullanıcıyı Sil</h3><p>Kullanıcı aktif listelerden kaldırılır ve mevcut kayıt geçmişi korunur.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Bu kullanıcı aktif listelerden kaldırılacaktır. Devam etmek istiyor musunuz?"><button class="crm-btn crm-btn-danger">Kullanıcıyı Sil</button></form></section></div>
<div id="password-reset" class="crm-modal" hidden="@(!openPasswordReset)" role="dialog" aria-modal="true" aria-labelledby="password-reset-title"><div class="crm-modal-card"><div><h3 id="password-reset-title">Parolayı Sıfırla</h3><button type="button" data-modal-close aria-label="Kapat">×</button></div><p class="crm-help">Parola en az 12 karakter; büyük ve küçük harf, rakam ve özel karakter içermelidir.</p><form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">@if(summaryErrors.Count>0){<div class="crm-validation-summary">@foreach(string error in summaryErrors){<p>@error</p>}</div>}<div class="crm-field"><label for="newPassword">Yeni parola</label><div class="crm-password"><input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required/><button type="button" data-password-toggle-for="newPassword" aria-label="Yeni parolayı göster veya gizle">Göster</button></div>@foreach(string error in passwordErrors){<span>@error</span>}</div><div class="crm-field"><label for="confirmPassword">Yeni parola tekrar</label><div class="crm-password"><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required/><button type="button" data-password-toggle-for="confirmPassword" aria-label="Parola tekrarını göster veya gizle">Göster</button></div>@foreach(string error in confirmationErrors){<span>@error</span>}</div><div class="crm-form-actions"><button class="crm-btn crm-btn-secondary" type="button" data-modal-close>İptal</button><button class="crm-btn crm-btn-primary">Parolayı Sıfırla</button></div></form></div></div>
