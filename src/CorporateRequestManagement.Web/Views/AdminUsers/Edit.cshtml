@model AdminUserFormPage
@{ViewData["Title"]="Kullanıcıyı Düzenle";var user=Model.User!;}
<div class="crm-page-head"><div><a class="crm-back" asp-action="Details" asp-route-id="@user.Id">← Kullanıcıya dön</a><span class="crm-kicker">Yönetim</span><h2>Kullanıcıyı Düzenle</h2><p>Kimlik, rol ve organizasyon bilgilerini güvenle güncelleyin.</p></div></div><section class="crm-card crm-form-card"><form method="post"><div asp-validation-summary="All" class="crm-validation-summary"></div><div class="crm-form-grid"><div class="crm-field"><label for="firstName">Ad</label><input id="firstName" name="firstName" value="@user.FirstName" required/></div><div class="crm-field"><label for="lastName">Soyad</label><input id="lastName" name="lastName" value="@user.LastName" required/></div><div class="crm-field crm-span-2"><label for="email">E-posta</label><input id="email" name="email" type="email" value="@user.Email" required/></div><div class="crm-field"><label for="role">Rol</label><select id="role" name="role"><option value="1" selected="@(user.Role==UserRoleContract.Employee)">Çalışan</option><option value="2" selected="@(user.Role==UserRoleContract.Manager)">Yönetici</option><option value="3" selected="@(user.Role==UserRoleContract.Admin)">Sistem Yöneticisi</option></select></div><div class="crm-field"><label for="departmentId">Departman</label><select id="departmentId" name="departmentId"><option value="">Departman gerekmiyor</option>@foreach(var d in Model.Departments){<option value="@d.Id" selected="@(user.DepartmentId==d.Id)">@d.Name</option>}</select></div><label class="crm-check"><input name="isActive" type="checkbox" value="true" checked="@user.IsActive"/><span>Hesap aktif</span></label></div><div class="crm-form-actions"><a class="crm-btn crm-btn-secondary" asp-action="Details" asp-route-id="@user.Id">İptal</a><button class="crm-btn crm-btn-primary">Değişiklikleri Kaydet</button></div></form></section>
