@model AdminUserContract
@{ViewData["Title"]="Profilim";}
<div class="crm-page-head"><div><h2>Profilim</h2><p>Kişisel ve kurumsal hesap bilgilerinizi görüntüleyin.</p></div></div><div class="crm-detail-grid"><section class="crm-card"><div class="crm-identity"><span class="crm-avatar crm-avatar-lg">@ManagementDisplay.Initials(Model.FirstName,Model.LastName)</span><div><h3>@Model.FirstName @Model.LastName</h3><p>@Model.Email</p><div><span class="crm-badge crm-badge-neutral">@UiDisplay.Role(Model.Role.ToString())</span> <span class="crm-badge crm-badge-@(Model.IsActive?"success":"neutral")">@ManagementDisplay.Active(Model.IsActive)</span></div></div></div><div class="crm-section-head"><div><h3>Kurumsal Bilgiler</h3><p>Organizasyon ve hesap özeti</p></div></div><div class="crm-detail-meta"><div><span>Departman</span><strong>@(Model.DepartmentName??"Atanmadı")</strong></div><div><span>Rol</span><strong>@UiDisplay.Role(Model.Role.ToString())</strong></div><div><span>Hesap oluşturulma</span><strong>@Model.CreatedDate.ToString("dd.MM.yyyy")</strong></div></div></section><section class="crm-card crm-security-card"><span class="crm-empty-icon"><i class="ki-outline ki-lock"></i></span><h3>Parolanı Güncelle</h3><p>Hesap güvenliğiniz için parolanızı düzenli aralıklarla yenileyin.</p><a class="crm-btn crm-btn-primary" asp-action="ChangePassword">Parolamı Değiştir</a></section></div>
