@model (ScopedRequestContract Request, bool CanDelete)
@{var request=Model.Request;var status=UiDisplay.Status(request.Status);}
<div class="crm-page-head"><div class="crm-detail-head__copy"><a class="crm-back" asp-action="Index">← Listeye dön</a><h2>@request.Title</h2><p>@request.RequesterName · @request.DepartmentName</p></div><span class="crm-badge crm-badge-lg crm-badge-@status.Tone">@status.Label</span></div>
<div class="crm-detail-grid">
    <div class="crm-stack">
        <section class="crm-card"><div class="crm-detail-meta"><div><span>Talep sahibi</span><strong>@request.RequesterName</strong></div><div><span>Departman</span><strong>@request.DepartmentName</strong></div><div><span>Talep türü</span><strong>@UiDisplay.Type(request.RequestType)</strong></div><div><span>Tutar</span><strong>@(request.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "Belirtilmedi")</strong></div><div><span>Oluşturulma</span><strong>@request.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong></div><div><span>Durum</span><strong>@status.Label</strong></div></div></section>
        <section class="crm-card"><div class="crm-section-head"><div><h3>Talep Açıklaması</h3><p>Talebin sahibi tarafından paylaşılan bilgiler</p></div></div><div class="crm-description"><p>@request.Description</p></div></section>
        <section class="crm-card"><div class="crm-section-head"><div><h3>Süreç Bilgileri</h3><p>Talebin önemli tarihleri</p></div></div><div class="crm-detail-meta"><div><span>Oluşturulma</span><strong>@request.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong></div>@if(request.SubmittedDate.HasValue){<div><span>Gönderilme</span><strong>@request.SubmittedDate.Value.ToString("dd.MM.yyyy HH:mm")</strong></div>}@if(request.CompletedDate.HasValue){<div><span>Tamamlanma</span><strong>@request.CompletedDate.Value.ToString("dd.MM.yyyy HH:mm")</strong></div>}</div></section>
    </div>
    <div class="crm-stack"><section class="crm-card"><div class="crm-section-head"><div><h3>Onay Geçmişi</h3><p>Talep üzerinde verilen kararlar</p></div></div><partial name="_ApprovalTimeline" model="request.ApprovalHistory" /></section>@if(Model.CanDelete){<section class="crm-card crm-danger-zone"><h3>Talebi Sil</h3><p>Talep aktif listelerden kaldırılır; işlem ve onay geçmişi korunur.</p><form asp-action="Delete" asp-route-id="@request.Id" method="post" data-confirm="Bu talep aktif listelerden kaldırılacaktır. Talebin işlem ve onay geçmişi korunacaktır. Devam etmek istiyor musunuz?"><input type="hidden" name="rowVersion" value="@request.RowVersion"/><button class="crm-btn crm-btn-danger" type="submit">Talebi Sil</button></form></section>}</div>
</div>
