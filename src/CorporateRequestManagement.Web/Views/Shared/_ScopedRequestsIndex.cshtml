@model ScopedRequestsPage
@{
    string controller = Model.IsAdmin ? "AdminRequests" : "ManagerRequests";
    string panelId = Model.IsAdmin ? "admin-request-filters" : "manager-request-filters";
    bool hasFilters = !string.IsNullOrWhiteSpace(Model.Query.Status) || !string.IsNullOrWhiteSpace(Model.Query.RequestType) || Model.Query.DepartmentId.HasValue || Model.Query.CreatedFrom.HasValue || Model.Query.CreatedTo.HasValue || Model.Query.MinAmount.HasValue || Model.Query.MaxAmount.HasValue || Model.Query.SortBy != "createdDate" || Model.Query.SortDirection != "Descending";
    var pagination = new PaginationViewModel(Model.Result.PageNumber, Model.Result.PageSize, Model.Result.TotalCount, Model.Result.TotalPages, Model.Result.HasPreviousPage, Model.Result.HasNextPage,
        new Dictionary<string, string?> { ["SearchTerm"] = Model.Query.SearchTerm, ["Status"] = Model.Query.Status, ["RequestType"] = Model.Query.RequestType, ["DepartmentId"] = Model.Query.DepartmentId?.ToString(), ["CreatedFrom"] = Model.Query.CreatedFrom?.ToString("O"), ["CreatedTo"] = Model.Query.CreatedTo?.ToString("O"), ["MinAmount"] = Model.Query.MinAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture), ["MaxAmount"] = Model.Query.MaxAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture), ["SortBy"] = Model.Query.SortBy, ["SortDirection"] = Model.Query.SortDirection, ["PageSize"] = Model.Query.PageSize.ToString() });
}
<div class="crm-page-head"><div><span class="crm-kicker">@(Model.IsAdmin ? "Yönetim" : "Departman")</span><h2>@(Model.IsAdmin ? "Tüm Talepler" : "Departman Talepleri")</h2><p>@(Model.IsAdmin ? "Şirket genelindeki talepleri görüntüleyin, filtreleyin ve süreçlerini takip edin." : "Departmanınızdaki talepleri görüntüleyin ve süreçlerini takip edin.")</p></div></div>
<div class="crm-request-toolbar">
    <form method="get" class="crm-search-form crm-request-toolbar__search" role="search">
        <input type="hidden" name="PageSize" value="@Model.Query.PageSize" /><input type="hidden" name="Status" value="@Model.Query.Status"/><input type="hidden" name="RequestType" value="@Model.Query.RequestType"/><input type="hidden" name="DepartmentId" value="@Model.Query.DepartmentId"/><input type="hidden" name="CreatedFrom" value="@Model.Query.CreatedFrom?.ToString("O")"/><input type="hidden" name="CreatedTo" value="@Model.Query.CreatedTo?.ToString("O")"/><input type="hidden" name="MinAmount" value="@Model.Query.MinAmount"/><input type="hidden" name="MaxAmount" value="@Model.Query.MaxAmount"/><input type="hidden" name="SortBy" value="@Model.Query.SortBy"/><input type="hidden" name="SortDirection" value="@Model.Query.SortDirection"/>
        <label class="crm-visually-hidden" for="scoped-request-search">Talep ara</label>
        <input id="scoped-request-search" name="SearchTerm" value="@Model.Query.SearchTerm" maxlength="100" placeholder="Talep başlığı veya açıklamasında ara" />
        <button class="crm-btn crm-btn-secondary" type="submit">Ara</button>
    </form>
    <div class="crm-actions crm-request-toolbar__actions"><button class="crm-btn crm-btn-secondary" type="button" data-crm-filter-toggle aria-expanded="@(hasFilters.ToString().ToLowerInvariant())" aria-controls="@panelId">Filtreler @if(hasFilters){<span class="crm-filter-dot" aria-label="Aktif filtre var"></span>}</button></div>
</div>
<div id="@panelId" class="crm-filter-panel" data-crm-filter-panel hidden="@(!hasFilters)">
    <form method="get" class="crm-filter">
        <input type="hidden" name="SearchTerm" value="@Model.Query.SearchTerm" /><input type="hidden" name="PageSize" value="@Model.Query.PageSize" />
        <div><label for="scope-status">Durum</label><select id="scope-status" name="Status"><option value="">Tümü</option>@foreach(var value in Enum.GetValues<RequestStatusContract>()){<option value="@value" selected="@(Model.Query.Status == value.ToString())">@UiDisplay.Status(value).Label</option>}</select></div>
        <div><label for="scope-type">Talep türü</label><select id="scope-type" name="RequestType"><option value="">Tümü</option>@foreach(var value in Enum.GetValues<RequestTypeContract>()){<option value="@value" selected="@(Model.Query.RequestType == value.ToString())">@UiDisplay.Type(value)</option>}</select></div>
        @if(Model.IsAdmin){<div><label for="scope-department">Departman</label><select id="scope-department" name="DepartmentId"><option value="">Tümü</option>@foreach(var department in Model.Departments){<option value="@department.Id" selected="@(Model.Query.DepartmentId == department.Id)">@department.Name</option>}</select></div>}
        <div><label for="scope-from">Başlangıç tarihi</label><input id="scope-from" name="CreatedFrom" type="date" value="@Model.Query.CreatedFrom?.ToString("yyyy-MM-dd")" /></div>
        <div><label for="scope-to">Bitiş tarihi</label><input id="scope-to" name="CreatedTo" type="date" value="@Model.Query.CreatedTo?.ToString("yyyy-MM-dd")" /></div>
        <div><label for="scope-min">Minimum tutar</label><input id="scope-min" name="MinAmount" type="number" min="0.01" step="0.01" value="@Model.Query.MinAmount" /></div>
        <div><label for="scope-max">Maksimum tutar</label><input id="scope-max" name="MaxAmount" type="number" min="0.01" step="0.01" value="@Model.Query.MaxAmount" /></div>
        <div><label for="scope-sort">Sıralama</label><select id="scope-sort" name="SortBy"><option value="createdDate" selected="@(Model.Query.SortBy == "createdDate")">Oluşturulma</option><option value="amount" selected="@(Model.Query.SortBy == "amount")">Tutar</option></select></div>
        <div><label for="scope-direction">Yön</label><select id="scope-direction" name="SortDirection"><option value="Descending" selected="@(Model.Query.SortDirection == "Descending")">Azalan</option><option value="Ascending" selected="@(Model.Query.SortDirection == "Ascending")">Artan</option></select></div>
        <footer class="crm-filter-footer"><div class="crm-filter-actions"><a class="crm-btn crm-btn-secondary" asp-controller="@controller" asp-action="Index">Filtreleri Temizle</a><button class="crm-btn crm-btn-primary" type="submit">Uygula</button></div></footer>
    </form>
</div>
<section class="crm-card crm-table-card">
@if(Model.Result.Items.Count == 0){<partial name="_EmptyState" model='("Talep bulunamadı.", "Arama ve filtrelerinizi değiştirerek yeniden deneyin.")' />}
else{<div class="crm-table-wrap"><table class="crm-request-table crm-wide-table"><thead><tr><th>Talep</th><th>Talep Sahibi</th><th>Departman</th><th>Tür</th><th class="crm-text-end">Tutar</th><th class="crm-text-center">Durum</th><th>Oluşturulma</th><th class="crm-text-end">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model.Result.Items){var status=UiDisplay.Status(item.Status);<tr><td data-label="Talep"><a class="crm-request-title-link" asp-controller="@controller" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><small>#@item.Id.ToString()[..8]</small></td><td data-label="Talep Sahibi"><strong>@item.RequesterName</strong><small>@item.RequesterEmail</small></td><td data-label="Departman">@item.DepartmentName</td><td data-label="Tür">@UiDisplay.Type(item.RequestType)</td><td data-label="Tutar" class="crm-money">@(item.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "—")</td><td data-label="Durum" class="crm-text-center"><span class="crm-badge crm-badge-@status.Tone">@status.Label</span></td><td data-label="Oluşturulma" class="crm-date">@item.CreatedDate.ToString("dd.MM.yyyy")</td><td data-label="İşlemler" class="crm-text-end"><details class="crm-action-menu"><summary>İşlemler <span aria-hidden="true">⋮</span></summary><div><a asp-controller="@controller" asp-action="Details" asp-route-id="@item.Id">Detayı Görüntüle</a>@if(Model.IsAdmin){<form asp-controller="AdminRequests" asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Bu talep aktif listelerden kaldırılacaktır. Talebin işlem ve onay geçmişi korunacaktır. Devam etmek istiyor musunuz?"><input type="hidden" name="rowVersion" value="@item.RowVersion" /><button class="crm-menu-danger" type="submit">Sil</button></form>}</div></details></td></tr>}
</tbody></table></div><partial name="_Pagination" model="pagination" />}
</section>
