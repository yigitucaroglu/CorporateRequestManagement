@model IReadOnlyList<ApprovalHistoryContract>
@if(Model.Count==0){<partial name="_EmptyState" model='("Henüz karar bulunmuyor.", "Onay süreci başladığında kararlar burada listelenecek.")'/>}else{<ol class="crm-timeline">@foreach(var item in Model){var state=UiDisplay.Approval(item.ApprovalStatus);<li><span class="crm-timeline-dot crm-dot-@state.Tone"></span><div><div><strong>@UiDisplay.Level(item.ApprovalLevel) · @state.Label</strong><time>@item.ActionDate.ToString("dd.MM.yyyy HH:mm")</time></div><p>@item.ApproverName</p>@if(!string.IsNullOrWhiteSpace(item.Description)){<blockquote>@item.Description</blockquote>}</div></li>}</ol>}
