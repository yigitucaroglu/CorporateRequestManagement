@model ApprovalQueuePage
@{
    bool hasFilters=Model.Query.RequestType.HasValue||Model.Query.CreatedFrom.HasValue||Model.Query.CreatedTo.HasValue||Model.Query.DepartmentId.HasValue||Model.Query.SortBy!="submittedDate"||Model.Query.SortDirection!="Ascending";
    var pagination=new PaginationViewModel(Model.Result.PageNumber,Model.Result.PageSize,Model.Result.TotalCount,Model.Result.TotalPages,Model.Result.HasPreviousPage,Model.Result.HasNextPage,new Dictionary<string,string?>{{"SearchTerm",Model.Query.SearchTerm},{"RequestType",Model.Query.RequestType?.ToString()},{"DepartmentId",Model.IsAdmin?Model.Query.DepartmentId?.ToString():null},{"CreatedFrom",Model.Query.CreatedFrom?.ToString("O")},{"CreatedTo",Model.Query.CreatedTo?.ToString("O")},{"SortBy",Model.Query.SortBy},{"SortDirection",Model.Query.SortDirection},{"PageSize",Model.Query.PageSize.ToString(System.Globalization.CultureInfo.InvariantCulture)}});
}
<div class="crm-page-head"><div><h2>@(Model.IsAdmin?"Yönetim Onayları":"Yönetici Onayları")</h2><p>@Model.Result.TotalCount bekleyen talep · Güvenli kapsamınız içinde arayın ve filtreleyin.</p></div></div>
<div class="crm-request-toolbar crm-list-toolbar"><form method="get" class="crm-search-form crm-request-toolbar__search" role="search"><input type="hidden" name="PageNumber" value="1"/><input type="hidden" name="PageSize" value="@Model.Query.PageSize"/><input type="hidden" name="RequestType" value="@Model.Query.RequestType"/><input type="hidden" name="DepartmentId" value="@(Model.IsAdmin?Model.Query.DepartmentId:null)"/><input type="hidden" name="CreatedFrom" value="@Model.Query.CreatedFrom?.ToString("O")"/><input type="hidden" name="CreatedTo" value="@Model.Query.CreatedTo?.ToString("O")"/><input type="hidden" name="SortBy" value="@Model.Query.SortBy"/><input type="hidden" name="SortDirection" value="@Model.Query.SortDirection"/><label class="crm-visually-hidden" for="approval-search">Onay kuyruğunda ara</label><input id="approval-search" name="SearchTerm" value="@Model.Query.SearchTerm" maxlength="100" placeholder="Talep başlığı veya talep sahibinde ara"/><button class="crm-btn crm-btn-secondary" type="submit">Ara</button></form><div class="crm-actions crm-request-toolbar__actions"><button class="crm-btn crm-btn-secondary" type="button" data-crm-filter-toggle aria-expanded="@hasFilters.ToString().ToLowerInvariant()" aria-controls="approval-filters">Filtreler</button></div></div>
<div id="approval-filters" class="crm-filter-panel" hidden="@(!hasFilters)"><form method="get" class="crm-filter"><input type="hidden" name="PageNumber" value="1"/><input type="hidden" name="PageSize" value="@Model.Query.PageSize"/><input type="hidden" name="SearchTerm" value="@Model.Query.SearchTerm"/><div><label for="approval-type">Talep Türü</label><select id="approval-type" name="RequestType"><option value="">Tümü</option>@foreach(var type in Enum.GetValues<RequestTypeContract>()){<option value="@type" selected="@(Model.Query.RequestType==type)">@UiDisplay.Type(type)</option>}</select></div><div><label for="approval-from">Başlangıç</label><input id="approval-from" type="date" name="CreatedFrom" value="@Model.Query.CreatedFrom?.ToString("yyyy-MM-dd")"/></div><div><label for="approval-to">Bitiş</label><input id="approval-to" type="date" name="CreatedTo" value="@Model.Query.CreatedTo?.ToString("yyyy-MM-dd")"/></div><div><label for="approval-sort">Sıralama</label><select id="approval-sort" name="SortBy"><option value="submittedDate" selected="@(Model.Query.SortBy=="submittedDate")">Gönderim tarihi</option><option value="amount" selected="@(Model.Query.SortBy=="amount")">Tutar</option><option value="requestType" selected="@(Model.Query.SortBy=="requestType")">Talep türü</option><option value="requesterName" selected="@(Model.Query.SortBy=="requesterName")">Talep sahibi</option></select></div><div><label for="approval-direction">Yön</label><select id="approval-direction" name="SortDirection"><option value="Ascending" selected="@(Model.Query.SortDirection=="Ascending")">Artan</option><option value="Descending" selected="@(Model.Query.SortDirection=="Descending")">Azalan</option></select></div><footer class="crm-filter-footer"><div class="crm-filter-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index">Temizle</a><button class="crm-btn crm-btn-primary">Filtrele</button></div></footer></form></div>
<section class="crm-card crm-table-card">
@if(Model.Result.Items.Count==0)
{
    @if(!string.IsNullOrWhiteSpace(Model.Query.SearchTerm)){<div class="crm-empty"><span class="crm-empty-icon"><i class="ki-outline ki-magnifier"></i></span><h3>Aramanızla eşleşen onay talebi bulunamadı.</h3><p>Farklı bir ifade deneyin veya arama ve filtreleri temizleyin.</p><a class="crm-btn crm-btn-secondary" asp-action="Index">Arama ve filtreleri temizle</a></div>}
    else if(Model.IsAdmin){<div class="crm-empty"><span class="crm-empty-icon"><i class="ki-outline ki-check-circle"></i></span><h3>Yönetim onayı bekleyen talep bulunmuyor</h3><p>Şu anda son onayınızı bekleyen bir talep yok.</p><a class="crm-btn crm-btn-secondary" asp-controller="AdminRequests" asp-action="Index">Tüm Taleplere Git</a></div>}
    else{<div class="crm-empty"><span class="crm-empty-icon"><i class="ki-outline ki-check-circle"></i></span><h3>Onay bekleyen talep bulunmuyor</h3><p>Departmanınızda şu anda değerlendirmenizi bekleyen bir talep yok.</p><a class="crm-btn crm-btn-secondary" asp-controller="ManagerRequests" asp-action="Index">Departman Taleplerine Git</a></div>}
}
else
{
    <div class="crm-table-wrap"><table class="crm-request-table crm-approval-table-standard"><thead><tr><th>Talep</th><th>Talep Sahibi</th>@if(Model.IsAdmin){<th>Departman</th>}<th>Tür</th><th>Tutar</th><th>Gönderim</th><th>İşlemler</th></tr></thead><tbody>@foreach(var item in Model.Result.Items){<tr><td data-label="Talep"><strong>@item.Title</strong></td><td data-label="Talep Sahibi">@item.RequesterName</td>@if(Model.IsAdmin){<td data-label="Departman">@item.DepartmentName</td>}<td data-label="Tür">@UiDisplay.Type(item.RequestType)</td><td data-label="Tutar">@(item.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))??"—")</td><td data-label="Gönderim">@item.SubmittedDate?.ToString("dd.MM.yyyy HH:mm")</td><td data-label="İşlemler"><a class="crm-btn crm-btn-quiet" asp-action="Details" asp-route-id="@item.RequestId">İncele</a></td></tr>}</tbody></table></div><partial name="_Pagination" model="pagination"/>
}
</section>
