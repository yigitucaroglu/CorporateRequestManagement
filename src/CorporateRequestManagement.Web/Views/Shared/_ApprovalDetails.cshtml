@model ApprovalDetailsPage
@{var status=UiDisplay.Status(Model.Request.RequestStatus);}
<div class="crm-page-head"><div><a class="crm-back" asp-action="Index">← Onay kuyruğuna dön</a><h2>@Model.Request.Title</h2><p>@Model.Request.RequesterName · @Model.Request.DepartmentName</p></div><span class="crm-badge crm-badge-lg crm-badge-@status.Tone">@status.Label</span></div>
<div class="crm-detail-grid"><section class="crm-card"><div class="crm-decision-summary"><div><span>Talep Türü</span><strong>@UiDisplay.Type(Model.Request.RequestType)</strong></div><div><span>Tutar</span><strong>@(Model.Request.Amount?.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "Belirtilmedi")</strong></div><div><span>Gönderim</span><strong>@Model.Request.SubmittedDate?.ToString("dd.MM.yyyy HH:mm")</strong></div></div><div class="crm-description"><h3>Talep Açıklaması</h3><p>@Model.Request.Description</p></div><div class="crm-decision-panel"><div><h3>Kararınız</h3><p>Karar vermeden önce talep bilgilerini ve geçmişini kontrol edin.</p></div><div class="crm-decision-buttons"><form asp-action="Approve" asp-route-id="@Model.Request.RequestId" method="post" data-confirm="Talebi onaylamak istediğinize emin misiniz?"><input type="hidden" name="RowVersion" value="@Model.Request.RowVersion"/><button class="crm-btn crm-btn-success">Onayla</button></form><button class="crm-btn crm-btn-danger" type="button" data-modal-open="reject-modal">Reddet</button></div></div></section><section class="crm-card"><div class="crm-section-head"><div><h3>Onay Geçmişi</h3><p>Önceki kararlar ve açıklamalar</p></div></div><partial name="_ApprovalTimeline" model="Model.Request.ApprovalHistory"/></section></div>
<div class="crm-modal" id="reject-modal" role="dialog" aria-modal="true" aria-labelledby="reject-title" hidden><div class="crm-modal-card"><div><h3 id="reject-title">Talebi Reddet</h3><button type="button" data-modal-close aria-label="Pencereyi kapat">×</button></div><p>Ret gerekçesi talep sahibine gösterilecektir.</p><form asp-action="Reject" asp-route-id="@Model.Request.RequestId" method="post" data-submit-form><input type="hidden" name="RowVersion" value="@Model.Request.RowVersion"/><div class="crm-field"><label for="Reason">Ret Gerekçesi</label><textarea id="Reason" name="Reason" maxlength="1000" rows="5" required data-count-input></textarea><small><span data-count-output>0</span>/1000</small></div><div class="crm-form-actions"><button class="crm-btn crm-btn-secondary" type="button" data-modal-close>Vazgeç</button><button class="crm-btn crm-btn-danger" data-submit-button>Talebi Reddet</button></div></form></div></div>
