@model NotFoundPage
@{
    var state = Model ?? new NotFoundPage(
        "Talep bulunamadı",
        "Aradığınız talep mevcut olmayabilir veya bu kaydı görüntüleme yetkiniz bulunmayabilir.",
        "Taleplerime Dön", "Requests", "Index");
    ViewData["Title"] = state.Title;
}
<section class="crm-state-page crm-card">
    <span class="crm-empty-icon"><i class="ki-outline ki-search-list"></i></span>
    <h2>@state.Title</h2>
    <p>@state.Message</p>
    <a class="crm-btn crm-btn-primary" asp-controller="@state.Controller" asp-action="@state.Action">@state.ReturnText</a>
</section>
