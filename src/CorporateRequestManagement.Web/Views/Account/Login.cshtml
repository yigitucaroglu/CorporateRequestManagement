@model LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Giriş"; }
<div class="d-flex flex-column flex-lg-row flex-column-fluid min-vh-100"><div class="d-flex flex-column flex-lg-row-fluid w-lg-50 p-10 order-2 order-lg-1"><div class="d-flex flex-center flex-column flex-lg-row-fluid"><div class="w-lg-500px p-10"><form asp-action="Login" method="post" class="form w-100" data-login-form><input asp-for="ReturnUrl" type="hidden"/><div class="text-center mb-11"><h1 class="text-gray-900 fw-bolder mb-3">Kurumsal Talep Yönetimi</h1><div class="text-gray-500 fw-semibold fs-6">Hesabınızla giriş yapın</div></div><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="fv-row mb-8"><label asp-for="Email" class="form-label">E-posta</label><input asp-for="Email" autocomplete="username" class="form-control bg-transparent"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="fv-row mb-3"><label asp-for="Password" class="form-label">Parola</label><div class="input-group"><input asp-for="Password" autocomplete="current-password" class="form-control bg-transparent"/><button class="btn btn-light" type="button" data-password-toggle aria-label="Parolayı göster">Göster</button></div><span asp-validation-for="Password" class="text-danger"></span></div><button type="submit" class="btn btn-primary w-100 mt-8" data-login-submit><span class="indicator-label">Giriş Yap</span><span class="indicator-progress">Lütfen bekleyin... <span class="spinner-border spinner-border-sm"></span></span></button></form></div></div></div><div class="d-flex flex-lg-row-fluid w-lg-50 bgi-size-cover bgi-position-center order-1 order-lg-2 crm-auth-visual"><div class="d-flex flex-column flex-center py-15 px-5 w-100"><img src="~/assets/media/logos/custom-1.png" class="h-75px mb-10" alt="Kurumsal Talep Yönetimi"/><img src="~/assets/media/misc/auth-screens.png" class="d-none d-lg-block mw-100 w-500px" alt=""/><h2 class="text-white fs-2qx fw-bold text-center">Taleplerinizi güvenle yönetin</h2></div></div></div>
