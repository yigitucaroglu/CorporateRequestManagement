@model LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Giriş Yap"; }
<main class="crm-auth-shell"><section class="crm-auth-story"><a class="crm-brand crm-brand-auth" href="/"><span class="crm-mark" aria-hidden="true"><i></i><b></b></span><span><strong>@ProductIdentity.Name</strong><small>Güvenli çalışma alanı</small></span></a><div class="crm-auth-copy"><span class="crm-kicker">Talep ve onay süreçleri</span><h1>Talep süreçlerinizi tek merkezden, güvenle yönetin.</h1><p>Kurumsal taleplerinizi oluşturun, onay akışlarını izleyin ve kararları şeffaf biçimde takip edin.</p><div class="crm-trust"><span>Güvenli oturum</span><span>Rol bazlı erişim</span><span>İzlenebilir kararlar</span></div></div></section>
<section class="crm-auth-panel"><div class="crm-login-card"><span class="crm-mobile-brand">@ProductIdentity.Name</span><h2>Hoş geldiniz</h2><p>Kurumsal talep süreçlerinize güvenli erişim sağlayın.</p><form asp-action="Login" method="post" data-submit-form novalidate><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="crm-validation-summary"></div><div class="crm-field"><label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="username" placeholder="ad.soyad@firma.com"/><span asp-validation-for="Email"></span></div><div class="crm-field"><label asp-for="Password">Parola</label><div class="crm-password"><input asp-for="Password" autocomplete="current-password"/><button type="button" data-password-toggle aria-label="Parolayı göster">Göster</button></div><span asp-validation-for="Password"></span></div><button type="submit" class="crm-btn crm-btn-primary crm-btn-block" data-submit-button><span>Giriş Yap</span><i class="crm-spinner" aria-hidden="true"></i></button></form><small class="crm-security-note"><i class="ki-outline ki-shield-tick"></i> Kurumsal hesabınızla güvenli ve kontrollü erişim sağlayın.</small></div></section></main>
