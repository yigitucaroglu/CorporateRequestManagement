@model AuditDetailsPage
@{var item=Model.Audit;ViewData["Title"]="İşlem Detayı";}
<div class="crm-page-head"><div class="crm-detail-head__copy"><a class="crm-back" asp-action="Index">← İşlem geçmişine dön</a><h2>@ManagementDisplay.Action(item.Action)</h2><p>@item.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p></div></div>
<div class="crm-detail-grid"><section class="crm-card"><div class="crm-identity"><span class="crm-avatar crm-avatar-lg">@ManagementDisplay.Initials(item.ActorFullName)</span><div><h3>@item.ActorFullName</h3><p>@(item.IsSystemActor ? "Otomatik sistem işlemi" : item.ActorEmail ?? "Hesap bilgisi kullanılamıyor")</p><div>@if(item.ActorRole.HasValue){<span class="crm-badge crm-badge-neutral">@UiDisplay.Role(item.ActorRole.Value.ToString())</span>} @if(item.ActorIsDeleted){<span class="crm-badge crm-badge-warning">Silinmiş hesap</span>}</div></div></div><div class="crm-detail-meta"><div><span>Kayıt türü</span><strong>@ManagementDisplay.Entity(item.EntityName)</strong></div><div><span>İşlem</span><strong>@ManagementDisplay.Action(item.Action)</strong></div><div><span>İşlem zamanı</span><strong>@item.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></div></div></section><section class="crm-card"><div class="crm-section-head"><div><h3>Güvenli Değişiklik Özeti</h3><p>Yalnız kullanıcıya gösterilmesi güvenli alanlar listelenir.</p></div></div>@if(Model.OldValues.Count==0&&Model.NewValues.Count==0){<p class="crm-help">Bu işlem için gösterilebilir bir alan değişikliği bulunmuyor.</p>}else{<div class="crm-change-grid"><div><h4>Önceki Bilgiler</h4>@foreach(var change in Model.OldValues){<dl><dt>@change.Label</dt><dd>@change.Value</dd></dl>}</div><div><h4>Yeni Bilgiler</h4>@foreach(var change in Model.NewValues){<dl><dt>@change.Label</dt><dd>@change.Value</dd></dl>}</div></div>}</section></div>
