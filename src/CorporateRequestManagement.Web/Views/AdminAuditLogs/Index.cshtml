@model AuditLogsPage
@{
    ViewData["Title"] = "İşlem Geçmişi";
    bool filtered = !string.IsNullOrWhiteSpace(Model.Query.EntityName) || !string.IsNullOrWhiteSpace(Model.Query.Action) || Model.Query.UserId.HasValue || Model.Query.CreatedFrom.HasValue || Model.Query.CreatedTo.HasValue;
    var pager = new PaginationViewModel(Model.Result.PageNumber, Model.Result.PageSize, Model.Result.TotalCount, Model.Result.TotalPages, Model.Result.HasPreviousPage, Model.Result.HasNextPage,
        new Dictionary<string, string?> { ["UserId"] = Model.Query.UserId?.ToString(), ["EntityId"] = Model.Query.EntityId?.ToString(), ["EntityName"] = Model.Query.EntityName, ["Action"] = Model.Query.Action, ["CreatedFrom"] = Model.Query.CreatedFrom?.ToString("O"), ["CreatedTo"] = Model.Query.CreatedTo?.ToString("O"), ["SortBy"] = Model.Query.SortBy, ["SortDirection"] = Model.Query.SortDirection, ["PageSize"] = Model.Query.PageSize.ToString(System.Globalization.CultureInfo.InvariantCulture) });
}
<div class="crm-page-head"><div><span class="crm-kicker">Güvenlik ve İzlenebilirlik</span><h2>İşlem Geçmişi</h2><p>Sistemde gerçekleşen önemli işlemleri kullanıcı dostu açıklamalarla inceleyin.</p></div><button class="crm-btn crm-btn-secondary" type="button" data-crm-filter-toggle aria-expanded="@(filtered.ToString().ToLowerInvariant())" aria-controls="history-filters">Filtreler</button></div>
@if(ViewData["Warning"] is string warning){<div class="crm-alert crm-alert-warning" role="status">@warning</div>}
<div id="history-filters" class="crm-filter-panel" hidden="@(!filtered)"><form method="get" class="crm-filter">
    <div><label for="history-type">Kayıt türü</label><select id="history-type" name="EntityName"><option value="">Tümü</option><option value="User">Kullanıcı</option><option value="Department">Departman</option><option value="CorporateRequest">Talep</option><option value="RequestApproval">Onay Süreci</option><option value="RefreshToken">Oturum Güvenliği</option></select></div>
    <div><label for="history-action">İşlem</label><select id="history-action" name="Action"><option value="">Tümü</option><option value="Authentication.LoginSucceeded">Başarılı giriş</option><option value="Authentication.RefreshTokenRotated">Oturum yenilendi</option><option value="Authentication.RefreshTokenRevoked">Oturum sonlandırıldı</option><option value="User.Created">Kullanıcı oluşturuldu</option><option value="User.Updated">Kullanıcı bilgileri güncellendi</option><option value="User.PasswordReset">Kullanıcı parolası sıfırlandı</option><option value="Department.Created">Departman oluşturuldu</option><option value="Department.Updated">Departman güncellendi</option><option value="Department.ManagerChanged">Departman yöneticisi değiştirildi</option><option value="CorporateRequest.Submitted">Talep onaya gönderildi</option><option value="CorporateRequest.SoftDeleted">Talep silindi</option></select></div>
    <div><label for="history-user">İşlemi yapan</label><select id="history-user" name="UserId" disabled="@(!Model.ActorFilterAvailable)"><option value="">Tüm kullanıcılar</option>@foreach(var actor in Model.Actors){<option value="@actor.Id" selected="@(Model.Query.UserId==actor.Id)">@actor.FullName — @actor.Email</option>}</select></div>
    <div><label for="history-from">Başlangıç tarihi</label><input id="history-from" name="CreatedFrom" type="date" value="@Model.Query.CreatedFrom?.ToString("yyyy-MM-dd")"/></div><div><label for="history-to">Bitiş tarihi</label><input id="history-to" name="CreatedTo" type="date" value="@Model.Query.CreatedTo?.ToString("yyyy-MM-dd")"/></div>
    <footer class="crm-filter-footer"><div class="crm-filter-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index">Filtreleri Temizle</a><button class="crm-btn crm-btn-primary">Uygula</button></div></footer>
</form></div>
<section class="crm-card crm-table-card">
@if(Model.Result.Items.Count==0){<partial name="_EmptyState" model='("İşlem kaydı bulunamadı.","Seçtiğiniz filtrelerle eşleşen bir kayıt bulunmuyor.")'/>}
else{<div class="crm-table-wrap"><table class="crm-request-table"><thead><tr><th>Tarih</th><th>İşlemi Yapan</th><th>Kayıt Türü</th><th>İşlem</th><th class="crm-text-end">İşlemler</th></tr></thead><tbody>@foreach(var item in Model.Result.Items){<tr><td data-label="Tarih">@item.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td data-label="İşlemi Yapan"><span class="crm-audit-actor"><span class="crm-avatar">@ManagementDisplay.Initials(item.ActorFullName)</span><span><strong>@item.ActorFullName</strong><small>@(item.IsSystemActor ? "Otomatik sistem işlemi" : item.ActorEmail ?? "Hesap bilgisi kullanılamıyor")</small><span class="crm-audit-actor__badges">@if(item.ActorRole.HasValue){<span class="crm-badge crm-badge-neutral">@UiDisplay.Role(item.ActorRole.Value.ToString())</span>}@if(item.ActorIsDeleted){<span class="crm-badge crm-badge-warning">Silinmiş hesap</span>}</span></span></span></td><td data-label="Kayıt Türü">@ManagementDisplay.Entity(item.EntityName)</td><td data-label="İşlem"><strong>@ManagementDisplay.Action(item.Action)</strong></td><td data-label="İşlemler" class="crm-text-end"><details class="crm-action-menu"><summary>İşlemler <span aria-hidden="true">⋮</span></summary><div><a asp-action="Details" asp-route-id="@item.Id">Detayı Görüntüle</a></div></details></td></tr>}</tbody></table></div><partial name="_Pagination" model="pager"/>}
</section>
