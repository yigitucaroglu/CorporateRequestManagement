@model AdminDepartmentDetailsPage
@{ var d = Model.Department; ViewData["Title"] = "Departmanı Düzenle"; }
<div class="crm-page-head"><div class="crm-detail-head__copy"><a class="crm-back" asp-action="Details" asp-route-id="@d.Id">← Departmana dön</a><h2>Departmanı Düzenle</h2><p>Departmanın organizasyon yapısında görünen adını güncelleyin.</p></div></div>
<section class="crm-card crm-form-card crm-form-card-narrow"><div class="crm-section-head"><div><h3>Departman Bilgileri</h3><p>Yönetici ataması departman detay sayfasından ayrı olarak yönetilir.</p></div></div><form method="post"><div asp-validation-summary="All" class="crm-validation-summary"></div><div class="crm-field"><label for="name">Departman adı</label><input id="name" name="name" value="@d.Name" required /></div><div class="crm-form-actions"><a class="crm-btn crm-btn-secondary" asp-action="Details" asp-route-id="@d.Id">İptal</a><button class="crm-btn crm-btn-primary">Adı Kaydet</button></div></form></section>
