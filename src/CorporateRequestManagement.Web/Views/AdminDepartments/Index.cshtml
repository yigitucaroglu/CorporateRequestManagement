@model AdminDepartmentsPage
@{ViewData["Title"]="Departmanlar";bool filtered=Model.Query.HasManager.HasValue;var pager=new PaginationViewModel(Model.Result.PageNumber,Model.Result.PageSize,Model.Result.TotalCount,Model.Result.TotalPages,Model.Result.HasPreviousPage,Model.Result.HasNextPage,new Dictionary<string,string?>{{"SearchTerm",Model.Query.SearchTerm},{"HasManager",Model.Query.HasManager?.ToString()},{"SortBy",Model.Query.SortBy},{"SortDirection",Model.Query.SortDirection},{"PageSize",Model.Query.PageSize.ToString(System.Globalization.CultureInfo.InvariantCulture)}});}
<div class="crm-page-head"><div><span class="crm-kicker">Yönetim</span><h2>Departmanlar</h2><p>Departmanları, yöneticilerini ve kullanıcı dağılımını yönetin.</p></div></div><div class="crm-request-toolbar"><form method="get" class="crm-search-form crm-request-toolbar__search"><label class="crm-visually-hidden" for="department-search">Departman ara</label><input id="department-search" name="SearchTerm" value="@Model.Query.SearchTerm" placeholder="Departman adında ara"/><button class="crm-btn crm-btn-secondary">Ara</button></form><div class="crm-actions crm-request-toolbar__actions"><button class="crm-btn crm-btn-secondary" type="button" data-crm-filter-toggle aria-expanded="@(filtered.ToString().ToLowerInvariant())" aria-controls="department-filters">Filtreler</button><a class="crm-btn crm-btn-primary" asp-action="Create">Yeni Departman</a></div></div><div id="department-filters" class="crm-filter-panel" hidden="@(!filtered)"><form method="get" class="crm-filter"><div><label for="has-manager">Yönetici durumu</label><select id="has-manager" name="HasManager"><option value="">Tümü</option><option value="true" selected="@(Model.Query.HasManager==true)">Yönetici atanmış</option><option value="false" selected="@(Model.Query.HasManager==false)">Yönetici atanmamış</option></select></div><footer class="crm-filter-footer"><div class="crm-filter-actions"><a class="crm-btn crm-btn-secondary" asp-action="Index">Filtreleri Temizle</a><button class="crm-btn crm-btn-primary">Uygula</button></div></footer></form></div><section class="crm-card crm-table-card">@if(Model.Result.Items.Count==0){<partial name="_EmptyState" model='("Departman bulunamadı.","Arama veya filtrelerinizi değiştirin.")'/>}else{<div class="crm-table-wrap"><table class="crm-request-table"><thead><tr><th>Departman</th><th>Yönetici</th><th>Aktif Kullanıcı</th><th>Talep Sayısı</th><th>Oluşturulma</th><th class="crm-text-end">İşlemler</th></tr></thead><tbody>@foreach(var x in Model.Result.Items){<tr><td data-label="Departman"><strong>@x.Name</strong></td><td data-label="Yönetici">@(x.ManagerName??"Yönetici atanmadı")</td><td data-label="Aktif Kullanıcı">@x.ActiveUserCount</td><td data-label="Talep Sayısı">@x.ActiveRequestCount</td><td data-label="Oluşturulma">@x.CreatedDate.ToString("dd.MM.yyyy")</td><td data-label="İşlemler" class="crm-text-end"><details class="crm-action-menu"><summary>İşlemler <span aria-hidden="true">⋮</span></summary><div><a asp-action="Details" asp-route-id="@x.Id">Detayı Görüntüle</a><a asp-action="Edit" asp-route-id="@x.Id">Düzenle</a><a asp-action="Edit" asp-route-id="@x.Id" asp-fragment="manager-assignment">Yönetici Ata</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" data-confirm="Bu departman aktif listelerden kaldırılacaktır. Devam etmek istiyor musunuz?"><button class="crm-menu-danger">Sil</button></form></div></details></td></tr>}</tbody></table></div><partial name="_Pagination" model="pager"/>}</section>
